<Window x:Class="Graph_Systems_Lab_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graph_Systems_Lab_3" xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1050" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
        <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFBEE6FD"/>
        <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
        <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
        <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
        <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
        <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
        <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
        <Style x:Key="component_button" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="base">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>


        <StackPanel x:Name="navigation_elem" Grid.Column="0" Grid.RowSpan="3">
            <StackPanel Orientation="Horizontal">

                <Image Source="/logo.png" Width="34" Height="30" Margin="5, 0, 0, 0" VerticalAlignment="Center" 
                           HorizontalAlignment="Left"/>

                <Label Content="АксиОМА Контрол" FontSize="16" FontWeight="Bold" Foreground="black"
       FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            </StackPanel>
            <Button HorizontalAlignment="Right" Width="180" Margin="20,20,5,0" Foreground="#4f4f4f" Height="30" >
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20" Margin="-30, -7, 0, -7" 
                           VerticalAlignment="Center" HorizontalAlignment="Left" Source="/main.png"/>

                    <StackPanel HorizontalAlignment="Left" Width="100" Margin="0, 0, 0, 0">
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" 
                                       FontFamily="Arial" FontStyle="Italic" Margin="0,3,0,0">
                        <Run Text="Главная"></Run>
                        </TextBlock>
                    </StackPanel>

                </StackPanel>

            </Button>

            <Button HorizontalAlignment="Right" Width="180" Margin="20,20,5,0" Foreground="#4f4f4f" Height="30">
                <StackPanel Orientation="Horizontal">

                    <Image Source="/time.png" Width="20" Height="20" Margin="-30,-7,0,-7" 
                   VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <StackPanel HorizontalAlignment="Left" Width="100" Margin="0, 0, 0, 0">

                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" 
                           FontSize="16" FontFamily="Arial" FontStyle="Italic" Margin="0,3,0,0">
                <Run Text="Мониторинг"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button HorizontalAlignment="Right" Width="180" Margin="20,20,5,0" Foreground="#4f4f4f" Height="30">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/analysis.png" Width="20" Height="20" Margin="-30,-7,0,-7" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <StackPanel HorizontalAlignment="Left" Width="100" Margin="0, 0, 0, 0">

                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" FontFamily="Arial" FontStyle="Italic" Margin="0,3,0,0">
<Run Text="Анализ"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button HorizontalAlignment="Right" Width="180" Margin="20,20,5,0" Foreground="#4f4f4f" Height="30">
                <StackPanel Orientation="Horizontal">

                    <Image Source="/report.png" Width="20" Height="20" Margin="-30,-7,0,-7" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <StackPanel HorizontalAlignment="Left" Width="100" Margin="0, 0, 0, 0">
                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" FontFamily="Arial" FontStyle="Italic" Margin="0,3,0,0">
<Run Text="Отчет"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Button>


            <!--выбор типа станка-->
            <Label Content="Тип станка:" FontSize="14" FontWeight="Bold" Foreground="#4f4f4f"
                FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Left" Margin="10, 3, 0, 0" Height="24"/>

            <!--Комбобокс станка-->
            <ComboBox x:Name="type_mt" Width="170" Height="30" Margin="0, 3, 0,0" DropDownClosed="type_mtDDClosed"/>

            <!--выбор наименования станка-->
            <Label Content="Наименование станка:" FontSize="14" FontWeight="Bold" Foreground="#4f4f4f"
                FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Left" Margin="10, 3, 0, 0" Height="24"/>

            <!--комбобокс наименование станка-->
            <ComboBox x:Name="name_mt" Width="170" Height="30" Margin="0, 3, 0,0" DropDownClosed="name_mtDCClosed"/>

            <!-- Картинка станка-->
            <Image Width="180" Height="132" Margin="10, 20, 0, 0" Source="/machine_DA_330_W24.png" Stretch="Uniform"/>

            <!--Кнопки под картинкой-->
            <Button Style="{DynamicResource component_button}" FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Left"
        Width="45" Height="30" Margin="20, 0, 0, 0" Foreground="#4f4f4f" FontSize="14" >
                <Image Width="25" Height="25" Margin="0, -2, 0, 0" Source="/video.png" Stretch="Uniform"/>
            </Button>

            <Button Style="{DynamicResource component_button}" FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Left"
        Width="45" Height="30" Margin="65,-30,0,0" Foreground="#4f4f4f" FontSize="14" >
                <Image Width="25" Height="25" Margin="0, -2, 0, 0" Source="/notes.png" Stretch="Uniform"/>
            </Button>

            <Button Style="{DynamicResource component_button}" FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Left"
Width="45" Height="30" Margin="110,-30,0,0" Foreground="#4f4f4f" FontSize="14" >
                <Image Width="25" Height="25" Margin="0, -2, 0, 0" Source="/left_arrow.png" Stretch="Uniform"/>
            </Button>
            <Button Style="{DynamicResource component_button}" FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Left"
Width="45" Height="30" Margin="155,-30,0,0" Foreground="#4f4f4f" FontSize="14" >
                <Image Width="25" Height="25" Margin="0, -2, 0, 0" Source="/left_arrow.png" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Button>

            <!--Надпись под кнопками-->
            <Label Content="{Binding Text, ElementName=name_mt}" FontSize="14" FontWeight="Bold" Foreground="#4f4f4f"
FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>


            <!--Информация о готовности осей-->
            <Button  FontFamily="Arial" FontStyle="Italic" HorizontalAlignment="Left"
                        Width="36" Height="36" Margin="20, 0, 0, 0" Foreground="#4f4f4f" FontSize="14" Background="#FF2FB22F">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" 
                               FontFamily="Arial" FontStyle="Italic" Margin="0,3,0,0">
                        <Run Text="X"/>
                </TextBlock>
            </Button>
            <Button  FontFamily="Arial" FontStyle="Italic" HorizontalAlignment="Left"
                        Width="36" Height="36" Margin="56, -36, 0, 0" Foreground="#4f4f4f" FontSize="14" Background="#FF2FB22F">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" 
                               FontFamily="Arial" FontStyle="Italic" Margin="0,3,0,0">
                        <Run Text="Y"/>
                </TextBlock>
            </Button>
            <Button  FontFamily="Arial" FontStyle="Italic" HorizontalAlignment="Left"
                        Width="36" Height="36" Margin="92, -36, 0, 0" Foreground="#4f4f4f" FontSize="14" Background="#FF2FB22F">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" 
                               FontFamily="Arial" FontStyle="Italic" Margin="0,3,0,0">
                        <Run Text="Z"/>
                </TextBlock>
            </Button>
            <Button  FontFamily="Arial" FontStyle="Italic" HorizontalAlignment="Left"
                        Width="36" Height="36" Margin="128, -36, 0, 0" Foreground="#4f4f4f" FontSize="14" Background="#FF2FB22F" >
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" 
                               FontFamily="Arial" FontStyle="Italic" Margin="0,3,0,0">
                        <Run Text="C"/>
                </TextBlock>
            </Button>
            <Button  FontFamily="Arial" FontStyle="Italic" HorizontalAlignment="Left"
        Width="36" Height="36" Margin="164, -36, 0, 0" Foreground="#4f4f4f" FontSize="14" Background="#FF3893B1">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" 
               FontFamily="Arial" FontStyle="Italic" Margin="0,3,0,0">
        <Run Text="Авто"/>
                </TextBlock>
            </Button>
        </StackPanel>

        <!--описание заголовка основной области-->
        <StackPanel x:Name="window" Grid.Column="1" Grid.ColumnSpan="2" Background="#e4e1d8">
            <Label x:Name="baseLabel" FontSize="18" FontWeight="Bold" Foreground="#4f4f4f"
                       FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Center"/>
        </StackPanel>

        <!--Разметка под вывод сообщений компонентов системы-->
        <StackPanel x:Name="component_says" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Background="#e4e1d8">

            <Label Content="Текущее значение компонентов" FontSize="18" FontWeight="Bold" Foreground="black" FontFamily="Arial" FontStyle="Italic" HorizontalAlignment="Center"/>

            <Line X1="10" Y1="0" X2="400" Y2="0" Stroke="Black"
                    StrokeThickness="1" HorizontalAlignment="Center"/>

            <StackPanel x:Name="button_components" Width="400" Height=" 600" HorizontalAlignment="Center" VerticalAlignment="Top">

                <Button Style="{DynamicResource component_button}" Content="Шпиндель" FontFamily="Arial" FontStyle="Italic" Width="70" 
                            Foreground="#4f4f4f" FontSize="14" Height="25" HorizontalAlignment="Left" Margin="5, 20, 5, 0"/>
                <Button Style="{DynamicResource component_button}" Content="Ось Х" FontFamily="Arial" FontStyle="Italic" Width="70" 
                            Foreground="#4f4f4f" FontSize="14" Height="25" HorizontalAlignment="Left" Margin="85, -25, 5, 0"/>
                <Button Style="{DynamicResource component_button}" Content="Ось Y" FontFamily="Arial" FontStyle="Italic" Width="70" 
                            Foreground="#4f4f4f" FontSize="14" Height="25" HorizontalAlignment="Left" Margin="165, -25, 5, 0"/>
                <Button Style="{DynamicResource component_button}" Content="Ось Z" FontFamily="Arial" FontStyle="Italic" Width="70" 
                            Foreground="#4f4f4f" FontSize="14" Height="25" HorizontalAlignment="Left" Margin="245, -25, 5, 0"/>
                <Button Style="{DynamicResource component_button}" Content="СЧПУ" FontFamily="Arial" FontStyle="Italic" Width="70" 
                            Foreground="#4f4f4f" FontSize="14" Height="25" HorizontalAlignment="Left" Margin="325, -25, 5, 0" 
                            Click="cncButton_Click"/>
                <Button Style="{DynamicResource component_button}" FontFamily="Arial" FontStyle="Italic" 
                            Width="70" Foreground="#4f4f4f" FontSize="10" Height="25" HorizontalAlignment="Left" Margin="5, 10, 5, 0">
                    <TextBlock TextAlignment="Center"><Run Text="Панель"/><LineBreak/><Run Text="оператора"/></TextBlock>
                </Button>

                <Button Style="{DynamicResource component_button}" FontFamily="Arial" FontStyle="Italic" 
                            Width="70" Foreground="#4f4f4f" FontSize="10" Height="25" HorizontalAlignment="Left" Margin="85, -25, 5, 0">
                    <TextBlock TextAlignment="Center"><Run Text="Станочный"/><LineBreak/><Run Text="пульт"/></TextBlock>
                </Button>

                <Button Style="{DynamicResource component_button}" Content="Технология" FontFamily="Arial" FontStyle="Italic" 
                            Width="70" Foreground="#4f4f4f" FontSize="14" Height="25" HorizontalAlignment="Left" Margin="165, -25, 5, 0"/>
                <Button Style="{DynamicResource component_button}" Content="Магазин" FontFamily="Arial" FontStyle="Italic" 
                            Width="70" Foreground="#4f4f4f" FontSize="14" Height="25" HorizontalAlignment="Left" Margin="245, -25, 5, 0"/>
                <Button Style="{DynamicResource component_button}" Content="Питание" FontFamily="Arial" FontStyle="Italic" 
                            Width="70" Foreground="#4f4f4f" FontSize="14" Height="25" HorizontalAlignment="Left" Margin="325, -25, 5, 0"/>

                <!--Таблица для получения данных из БД-->
                <DataGrid AutoGenerateColumns="false" x:Name="cncData" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle2}" 
                              Height="600" Margin="5, 10, 5, 0" ItemsSource="{Binding}" FontSize="14">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="dataGridTextColumn" Header="Наименование" Width="120" Binding="{Binding name}"/>
                        <DataGridTextColumn Header="Статус" Width="60" Binding="{Binding status}"/>
                        <DataGridTextColumn Header="Значение" Width="80" Binding="{Binding value}"/>
                        <DataGridTextColumn Header="Описание" Width="*" Binding="{Binding description}"/>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>

        </StackPanel>

        <!--Разметка под график загрузки оборудования-->
        <StackPanel x:Name="chart_load" Grid.Column="1" Grid.Row="1" Background="#e4e1d8">
            <Label Content="График загрузки оборудования" FontSize="18" FontWeight="Bold" Foreground="black"
                       FontFamily="Arial" FontStyle="Italic" HorizontalAlignment="Center"/>

            <Line X1="10" Y1="0" X2="400" Y2="0" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Center"/>

            <DatePicker FirstDayOfWeek="Monday" SelectedDateFormat="Short" x:Name="date_now" SelectedDate="05/19/23" 
                            Width="90" Margin="20, 10, 0, 0" HorizontalAlignment="Left" Height="25"/>
            <DatePicker x:Name="time_begin" Width="90" Margin="120, -25, 0, 0" HorizontalAlignment="Left" Height="24"/>
            <DatePicker x:Name="time_end" Width="90" Margin="220, -25, 0, 0" HorizontalAlignment="Left" Height="25"/>
            <Button Name="load_button" Content="Вывод" FontFamily="Arial" FontStyle="Italic" HorizontalAlignment="Left"
                        Width="70" Height="25" Margin="320, -25, 0, 0" Foreground="#4f4f4f" FontSize="14" 
                        Style="{DynamicResource component_button}" Click="load_button_Click"/>

            <!--График загрузки оборудования - Гистограмма с накоплениями-->
            <StackPanel Margin="0, 40, 0, 0">
                <DockPanel x:Name="load_column_chart" Width="350" HorizontalAlignment="Center" Height="300" Margin="20,0,0,0">
                    <DockPanel.DataContext>
                        <local:DBDataViewModel x:Name="model"></local:DBDataViewModel>
                    </DockPanel.DataContext>
                    <Button Content="{Binding offPct}" DockPanel.Dock="Bottom" Background="Black" Name="offButton"/>

                    <Button Content="{Binding loadPct}" DockPanel.Dock="Bottom" Background="Orange" Name="loadButton"/>

                    <Button Content="{Binding onPct}" DockPanel.Dock="Bottom" Background="Green" Name="onButton"/>
                </DockPanel>
            </StackPanel>

            <!--Подписи для граффика-->
            <StackPanel x:Name="percentage_mt_load" Width="20" Height="300" HorizontalAlignment="Left" Margin="20,-350,0,-50">
                <Label Content="100" Margin="0,0,0,0" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0"/>
                <Label Content="80" Margin="0,50,0,0" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0"/>
                <Label Content="60" Margin="0,50,0,0" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0"/>
                <Label Content="20" Margin="0,50,0,0" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0"/>
                <Label Content="0" Margin="0,50,0,0" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0"/>
            </StackPanel>

            <!--Единицы измерения-->
            <Label Content="%" RenderTransformOrigin="0.5, 0.5" Width="20" Margin="-85, -330, 0, 0" >
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-90"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Label.RenderTransform>
            </Label>

            <!--Подписи к графику-->
            <StackPanel Margin="60, 20, 100, 0" HorizontalAlignment="Center" Width="254">
                <Button Width="10" Height="10" Background="Black" HorizontalAlignment="Left"/>
                <Label Content="Выключен" Margin="15, -19, 100, 0"/>
                <Button Width="10" Height="10" Background="Orange" HorizontalAlignment="Left" Margin="90, -25, 0, 0"/>
                <Label Content="Нагрузка" Margin="105, -26, 0, 0"/>
                <Button Width="10" Height="10" Background="Green" HorizontalAlignment="Left" Margin="180, -25, 0, 0"/>
                <Label Content="Включен" Margin="195, -26, 0, 0"/>
            </StackPanel>

        </StackPanel>

        <StackPanel x:Name="chart_working" Grid.Column="1" Grid.Row="2" Background="#e4e1d8">
            <Label Content="График работы за текущие сутки" FontSize="18" FontWeight="Bold" Foreground="black" 
                       FontFamily="arial" FontStyle="Italic" HorizontalAlignment="Center"/>

            <StackPanel Margin="0, 20, 0, 0">
                <DockPanel x:Name="working_row_chart" Width="350" Height="70" HorizontalAlignment="Center">
                    <DockPanel.DataContext>
                        <local:DBDataViewModel x:Name="model2"></local:DBDataViewModel>

                    </DockPanel.DataContext>
                    <lvc:CartesianChart Series="{Binding SeriesCollection}" IsHitTestVisible="False">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels=""></lvc:Axis>

                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Labels=""></lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>


                </DockPanel>
                <StackPanel Orientation="Horizontal" Width="360" Height="20">
                    <Label Content="00" VerticalAlignment="Center" Padding="0"/>
                    <Label Content="03" VerticalAlignment="Center" Padding="0" Margin="30, 0, 0, 0"/>
                    <Label Content="06" VerticalAlignment="Center" Padding="0" Margin="30, 0, 0, 0"/>
                    <Label Content="09" VerticalAlignment="Center" Padding="0" Margin="30, 0, 0, 0"/>
                    <Label Content="12" VerticalAlignment="Center" Padding="0" Margin="30, 0, 0, 0"/>
                    <Label Content="15" VerticalAlignment="Center" Padding="0" Margin="30, 0, 0, 0"/>
                    <Label Content="18" VerticalAlignment="Center" Padding="0" Margin="30, 0, 0, 0"/>
                    <Label Content="21" VerticalAlignment="Center" Padding="0" Margin="30, 0, 0, 0"/>
                    <Label Content="24" VerticalAlignment="Center" Padding="0" Margin="30, 0, 0, 0"/>
                </StackPanel>
                <StackPanel Margin="60, 20, 100, 0" Width="300">
                    <Button Width="10" Height="10" Background="Black" HorizontalAlignment="Left"/>
                    <Label Content="Выключен" Margin="15, -19, 100, 0"/>
                    <Button Width="10" Height="10" Background="orange" HorizontalAlignment="Left" Margin="90, -25, 0, 0"/>
                    <Label Content="Нагрузка" Margin="105, -26, 0, 0"/>
                    <Button Width="10" Height="10" Background="Green" HorizontalAlignment="Left" Margin="180, -25, 0, 0"/>
                    <Label Content="Включен" Margin="195, -26, 0, 0"/>
                </StackPanel>
            </StackPanel>
            <Button Content="Вывод" FontFamily="Arial" FontStyle="Italic" HorizontalAlignment="Center"
                        Width="70" Margin="255, 0, 0, 0" Foreground="#4f4f4f" FontSize="14" Height="25" Click="workingButton_Click"/>
        </StackPanel>

    </Grid>

    
</Window>
